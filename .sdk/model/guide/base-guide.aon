# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 2
  metrics: count: method: 2

  entity: authentication: {
    path: "/api/auth/login": {
      op: create: method: *POST
      op: create: transform: res: *("`body.user`")|top
    }
    path: "/api/auth/verify-mobile": {
      op: create: method: *POST
    }
  }

}