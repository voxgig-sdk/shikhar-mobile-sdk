# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: {
    message: {
      h: "Message"
      n: "message"
      r: false
      t: "`$STRING`"
    }
    mobile: {
      h: "Mobile"
      n: "mobile"
      r: true
      sh: "User's mobile number"
      t: "`$STRING`"
    }
    password: {
      fo: "password"
      h: "Password"
      n: "password"
      r: true
      sh: "User's password"
      t: "`$STRING`"
    }
    success: {
      h: "Success"
      n: "success"
      r: false
      t: "`$BOOLEAN`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "Authentication token"
      t: "`$STRING`"
    }
    user: {
      h: "User"
      n: "user"
      r: false
      t: "`$OBJECT`"
    }
    verificationId: {
      h: "Verification Id"
      n: "verificationId"
      r: false
      t: "`$STRING`"
    }
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "mobile"
            "password"
          ]
          co: {
            id: "POST /api/auth/login"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/auth/login"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "login"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          bf: [
            "mobile"
          ]
          co: {
            id: "POST /api/auth/verify-mobile"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/auth/verify-mobile"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "auth"
            }
            {
              lit: "verify-mobile"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
