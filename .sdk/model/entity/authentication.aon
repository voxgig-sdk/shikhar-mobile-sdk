# Entity: authentication

main: kit: entity: authentication: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "message"
      req: false
      type: "`$STRING`"
    }
    {
      name: "mobile"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "User's mobile number"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      type: "`$STRING`"
    }
    {
      name: "password"
      req: true
      short: "User's password"
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
    {
      name: "verificationId"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "authentication"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/auth/login"
          parts: [
            "api"
            "auth"
            "login"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
        {
          method: "POST"
          orig: "/api/auth/verify-mobile"
          parts: [
            "api"
            "auth"
            "verify-mobile"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
